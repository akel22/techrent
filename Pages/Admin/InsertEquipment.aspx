<%@ Page Title="Insert Equipment" Language="C#" MasterPageFile="~/Pages/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="InsertEquipment.aspx.cs" Inherits="Techrent.Pages.Admin.InsertEquipment" %>

<asp:Content ID="HeadContent" ContentPlaceHolderID="HeadContent" runat="server">
    <link href="<%: ResolveUrl("~/css/admin/InsertEquipment.css?v=1") %>" rel="stylesheet" />
</asp:Content>

<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
    <section class="insert-equipment" aria-labelledby="insertEquipmentHeading">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
            <div>
                <p class="text-uppercase text-muted small fw-semibold mb-1">Equipment inventory</p>
                <h1 id="insertEquipmentHeading" class="h3 mb-1">Insert equipment</h1>
                <p class="text-muted mb-0">Enter the equipment details defined by the inventory model.</p>
            </div>
            <a class="btn btn-outline-secondary" href="<%: GetRouteUrl("Equipments", null) %>"><img src="<%: ResolveUrl("~/assets/svg/back.svg") %>" alt="" aria-hidden="true" width="16" height="16" class="me-1" />Back to inventory</a>
        </div>

        <div class="card admin-card">
            <div class="card-body p-3 p-md-4">
                <div id="equipmentFormAlert" runat="server" ClientIDMode="Static" class="alert alert-success d-none" role="status" tabindex="-1">Equipment saved successfully.</div>
                <div id="equipmentInsertionForm" role="form" aria-describedby="equipmentFormHelp" novalidate>
                    <p id="equipmentFormHelp" class="text-muted small mb-4">Equipment ID and date added are generated by the database. Image upload is optional.</p>
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="equipmentCategory" class="form-label">Category <span class="text-danger" aria-hidden="true">*</span></label>
                                    <select id="equipmentCategory" runat="server" class="form-select" required>
                                        <option value="">Select a category</option>
                                        <option value="Laptop">Laptop</option>
                                        <option value="Desktop">Desktop</option>
                                        <option value="Monitor">Monitor</option>
                                        <option value="Projector">Projector</option>
                                        <option value="Peripheral">Peripheral</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <div class="invalid-feedback">Select a valid equipment category.</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="equipmentType" class="form-label">Type <span class="text-danger" aria-hidden="true">*</span></label>
                                    <select id="equipmentType" runat="server" class="form-select" required>
                                        <option value="">Select a type</option>
                                        <option value="Obsolete">Obsolete</option>
                                        <option value="Standard">Standard</option>
                                        <option value="Professional">Professional</option>
                                    </select>
                                    <div class="invalid-feedback">Select a valid equipment type.</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="equipmentStatus" class="form-label">Status <span class="text-danger" aria-hidden="true">*</span></label>
                                    <select id="equipmentStatus" runat="server" class="form-select" required>
                                        <option value="Available" selected="selected">Available</option>
                                        <option value="Rented">Rented</option>
                                        <option value="Maintenance">Maintenance</option>
                                    </select>
                                    <div class="invalid-feedback">Select a valid equipment status.</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="equipmentStock" class="form-label">Stock <span class="text-danger" aria-hidden="true">*</span></label>
                                    <input id="equipmentStock" runat="server" class="form-control" type="number" min="0" step="1" required inputmode="numeric" aria-describedby="stockHelp" />
                                    <div id="stockHelp" class="form-text">Enter zero or a positive whole number.</div>
                                    <div class="invalid-feedback">Enter a whole-number stock value of zero or more.</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="equipmentBaseRentalFee" class="form-label">Base rental fee/hour <span class="text-danger" aria-hidden="true">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text" aria-hidden="true">&#8369;</span>
                                        <input id="equipmentBaseRentalFee" runat="server" class="form-control" type="number" min="0" step="0.01" required inputmode="decimal" aria-describedby="baseRentalFeeHelp" />
                                    </div>
                                    <div id="baseRentalFeeHelp" class="form-text">Enter zero or a positive amount.</div>
                                    <div class="invalid-feedback">Enter a valid base rental fee of zero or more.</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="equipmentSecurityDeposit" class="form-label">Security deposit <span class="text-danger" aria-hidden="true">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text" aria-hidden="true">&#8369;</span>
                                        <input id="equipmentSecurityDeposit" runat="server" class="form-control" type="number" min="0" step="0.01" required inputmode="decimal" aria-describedby="securityDepositHelp" />
                                    </div>
                                    <div id="securityDepositHelp" class="form-text">Enter zero or a positive amount.</div>
                                    <div class="invalid-feedback">Enter a valid security deposit of zero or more.</div>
                                </div>
                                <div class="col-12">
                                    <label for="equipmentModel" class="form-label">Model <span class="text-danger" aria-hidden="true">*</span></label>
                                    <input id="equipmentModel" runat="server" class="form-control" type="text" maxlength="200" required autocomplete="off" />
                                    <div class="invalid-feedback">Enter the equipment model.</div>
                                </div>
                                <div class="col-12">
                                    <label for="equipmentSku" class="form-label">SKU <span class="text-danger" aria-hidden="true">*</span></label>
                                    <input id="equipmentSku" runat="server" class="form-control" type="text" maxlength="100" required autocomplete="off" aria-describedby="skuHelp" />
                                    <div id="skuHelp" class="form-text">Each equipment record must use a unique SKU.</div>
                                    <div class="invalid-feedback">Enter the equipment SKU.</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="equipment-image-panel">
                                <label class="form-label" for="equipmentImage">Equipment image</label>
                                <div class="equipment-image-preview" id="equipmentImagePreviewContainer">
                                    <span id="equipmentImagePlaceholder">No attached image</span>
                                    <img id="equipmentImagePreview" class="equipment-image-preview-img d-none" alt="Equipment image preview" />
                                </div>
                                 <input id="equipmentImage" runat="server" ClientIDMode="Static" class="form-control mt-3" type="file" accept=".jpg,.png,.heic" aria-describedby="equipmentImageHelp" />
                                <div id="equipmentImageHelp" class="form-text">Accepted formats: JPG, PNG, and HEIC. HEIC preview depends on browser support.</div>
                                <div id="equipmentImageError" class="invalid-feedback d-block" hidden>Select a JPG, PNG, or HEIC image.</div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a class="btn btn-outline-secondary" href="<%: GetRouteUrl("Equipments", null) %>">Cancel</a>
                        <button id="equipmentPreviewButton" class="btn btn-primary" type="button">Review equipment</button>
                        <button id="saveEquipmentButton" runat="server" class="btn btn-success" type="submit" onserverclick="SaveEquipmentButton_ServerClick">Save equipment</button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</asp:Content>

<asp:Content ID="PageScripts" ContentPlaceHolderID="PageScripts" runat="server">
    <script src="<%: ResolveUrl("~/Scripts/Admin/InsertEquipment.js?v=1") %>"></script>
</asp:Content>
